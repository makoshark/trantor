% trantor.sty -- a Metropolis-style theme for the ltx-talk class.
% LuaLaTeX only. Fonts: Libertinus Serif/Sans (text) + Euler (maths).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{trantor}[2026-08-01 v1.0 Metropolis-like theme for ltx-talk]

% LuaTeX only (XeTeX is unsupported and the fonts need a Unicode engine).
\RequirePackage{iftex}
\RequireLuaTeX
\RequirePackage{tikz}
\RequirePackage{pifont}

\makeatletter

% Tighten the space around display maths -- the default 11pt reads as a big gap
% on a slide, especially inside a list. Re-applied on every \normalsize so the
% size files don't reset it.
\g@addto@macro\normalsize{%
  \setlength\abovedisplayskip{5pt plus 2pt minus 1pt}%
  \setlength\belowdisplayskip{5pt plus 2pt minus 1pt}%
  \setlength\abovedisplayshortskip{5pt plus 2pt minus 1pt}%
  \setlength\belowdisplayshortskip{5pt plus 2pt minus 1pt}%
}

% -- Colours. TrantorAccent is the one meant to be changed; set it with
% \trantorset (see the options block below). TrantorDark and TrantorMuted are
% the theme's own and can be \colorlet to taste.
\definecolor{TrantorAccent}{HTML}{2A7AE2}
\colorlet{TrantorDark}{black}
\colorlet{TrantorLight}{white}
% Lightest grey that still meets WCAG AA contrast (4.5:1) on white (~4.54:1).
\definecolor{TrantorMuted}{HTML}{767676}  % affiliation, footline, arxiv

% itemize/enumerate labels in the body colour rather than the class default
\AddToHook{begindocument}{\colorlet{structure}{TrantorDark}}

% Under "quotes = italic", quote and quotation are set in italic, as beamer did;
% decks ported from it are written expecting that.
\AddToHook{env/quote/begin}{\iftrantor@italicquotes\itshape\fi}
\AddToHook{env/quotation/begin}{\iftrantor@italicquotes\itshape\fi}

% State for the two look options; see the \trantorset block below. Plain \newif
% rather than expl3 bools, so the \AddToHook bodies here can read them directly.
\newif\iftrantor@darkheader   \trantor@darkheaderfalse
\newif\iftrantor@titledivider \trantor@titledividerfalse
\newif\iftrantor@restart      \trantor@restartfalse
% Set by \appendix itself, so the counter knows which side of it a slide is on.
\newif\iftrantor@inappendix   \trantor@inappendixfalse
\newif\iftrantor@documentfonts \trantor@documentfontsfalse
\newif\iftrantor@finallinks   \trantor@finallinksfalse
\newif\iftrantor@shownumber  \trantor@shownumbertrue
\newif\iftrantor@filllogo    \trantor@filllogofalse
\newif\iftrantor@italicquotes \trantor@italicquotesfalse
\newif\iftrantor@bareuntitled \trantor@bareuntitledfalse

% -- Header bar carrying the frame title (hidden on plain pages).
\AddToHook{begindocument}{%
  \iftrantor@darkheader
    % headsep is what pads under the title; the height key alone only pads above,
    % and the band needs the extra room to breathe. geometry has to be told the
    % new size too: the class sets the header's height to \Gm@tmargin + \headsep,
    % so leaving headheight at its 10mm default overflows every text block by
    % about 1.5pt.
    \geometry{headheight=30pt, headsep=10pt}%
    \EditInstance{header}{std}{
      background-color  = TrantorDark,
      color             = TrantorLight,
      print-frame-title = true,
      height            = 40pt,
      font              = \headerfont\bfseries,
      left-hspace       = \dimexpr\Gm@lmargin - 0.6cm\relax,
    }%
  \else
    \EditInstance{header}{std}{
      background-color  = TrantorLight,
      color             = TrantorDark,
      print-frame-title = true,
      height            = 30pt,
      font              = \headerfont\bfseries,
      left-hspace       = \dimexpr\Gm@lmargin - 0.6cm\relax,
    }%
  \fi
  \EditInstance{footer}{std}{element-order = {}}%
  \EditInstance{frametitle}{header}{after-vspace = 6mm minus 3mm}%
}

% -- Under "untitled = bare", a frame with no \frametitle gets no header band.
% The class draws it regardless, which under "header = dark" leaves an empty
% dark slab across the top of a full-bleed image slide; metropolis left such
% frames bare, and decks ported from it expect that.
%
% The band is drawn from \@oddhead, so this replaces \ps@talk, and \pagestyle
% has to be re-issued for the new definition to take. Read at shipout, so the
% key can be switched mid-talk.
\ExplSyntaxOn
\cs_new_protected:Npn \trantor@header
  {
    \iftrantor@bareuntitled
      % Guard the class internal: a class change should not make this an error.
      \cs_if_exist:NTF \g__talk_frame_title_tl
        {
          \tl_if_empty:NF \g__talk_frame_title_tl
            { \UseInstance { header } { std } }
        }
        { \UseInstance { header } { std } }
    \else
      \UseInstance { header } { std }
    \fi
  }
\cs_set_nopar:Npn \ps@talk
  {
    \cs_set_nopar:Npn \@oddhead { \trantor@header \hfil }
    \cs_set_nopar:Npn \@oddfoot { \UseInstance { footer } { std } }
    \cs_set_eq:NN \@evenhead \@oddhead
    \cs_set_eq:NN \@evenfoot \@oddfoot
  }
\ExplSyntaxOff
\pagestyle{talk}

% Like \frametitle, but forces a gap below the title on packed slides where the
% header's own spacing collapses. The \par gets us into vertical mode first.
\NewDocumentCommand\stitle{m}{\frametitle{#1}\par\addvspace{4mm}}

% \standoutline{...}: a centred line of text in the title's sans/size/colour,
% for emphasis within a normal (light) frame, e.g. closing a slide.
\NewDocumentCommand\standoutline{m}{%
  \par
  \begingroup
    \centering\headerfont\Large\bfseries\color{TrantorDark}#1\par
  \endgroup
}

% Tick and cross, for marking things right or wrong.
\NewDocumentCommand\yes{}{\ding{51}}
\NewDocumentCommand\no{}{\ding{55}}

% \footline{...}: a small reference or citation pinned to the bottom-left of
% the slide. Overlaid, so it can go anywhere inside the frame.
\newcommand\trantor@footlinepic[1]{%
  \begin{tikzpicture}[remember picture, overlay]
    \node[anchor=south west, xshift=1ex, yshift=0.7ex, font=\scriptsize, text=TrantorMuted]
      at (current page.south west) {#1};
  \end{tikzpicture}%
}
\NewDocumentCommand\footline{m}{%
  \ifvmode
    \nointerlineskip
    \vbox to 0pt{\vss\hbox to 0pt{\trantor@footlinepic{#1}\hss}}%
    \nointerlineskip
  \else
    \trantor@footlinepic{#1}%
  \fi
}

% \arxiv{1306.5001}: a small, grey "arXiv:<id>" tag linked to the abstract.
% Meant to sit inline next to a statement, e.g. a theorem.
\NewDocumentCommand\arxiv{m}{%
  \href{https://arxiv.org/abs/#1}{{\headerfont\scriptsize\color{TrantorMuted}arXiv:#1}}%
}

% -- Under "links = final", a link is kept only on the last slide of its frame.
%
% With the class's default tag-slides=n, every slide of a frame but the last is
% an artifact, and a link annotation inside an artifact fails PDF/UA-2 (8.2.5.20)
% wherever it came from -- this theme's furniture or the document's own text.
% Dropping the link on those slides, keeping its text, is the only way to stay
% compliant without tagging every slide, which would put every half-built state
% of a frame into the structure tree.
%
% The class has no overlay keyword for "last", so the test is the one the class
% uses itself, via the property it records per frame.
\ExplSyntaxOn
\prg_new_conditional:Npnn \__trantor_if_final_slide: { TF }
  {
    \exp_args:Ne \tl_if_blank:nTF
      { \property_ref:ee { frame . \int_use:N \g__talk_frame_int } { slides } }
      { \prg_return_true: }
      {
        \int_compare:nNnTF { \g__talk_slide_int } =
          { \property_ref:ee { frame . \int_use:N \g__talk_frame_int } { slides } }
          { \prg_return_true: } { \prg_return_false: }
      }
  }
\NewDocumentCommand \trantorIfFinalSlide { +m +m }
  { \__trantor_if_final_slide:TF {#1} {#2} }
% \let \href to this to keep a link's text and drop the link.
\NewDocumentCommand \trantorNoHref { m m } { #2 }

% The class's per-slide hook covers the theme's furniture and the document's own
% text alike. It ends by opening the slide box, so appending to it puts the
% assignment inside that box, where it is restored with it. Appended rather than
% copied, so the class's own body is whatever the installed release defines.
\cs_new_eq:NN \__trantor_slide_begin: \__talk_slide_begin:
\cs_gset_protected:Npn \__talk_slide_begin:
  {
    \__trantor_slide_begin:
    \legacy_if:nT { trantor@finallinks }
      { \trantorIfFinalSlide {} { \cs_set_eq:NN \href \trantorNoHref } }
  }
\ExplSyntaxOff

% -- Under a non-zero "column-sep", put a gutter back between columns.
%
% The class separates columns with \hfil inside a row built to exactly
% \textwidth, so the gutter is whatever width the author leaves unclaimed.
% beamer instead built the row at \textwidth plus both side margins, so two
% \begin{column}{0.5\textwidth} both fitted and still got a gutter, paid for out
% of the margins. Decks ported from beamer ask for columns summing to the full
% width and come out touching.
%
% Take the gutter out of the columns rather than widening the row past the text
% block, which would leave the first column hanging left of the frame title: the
% row still measures \textwidth, but \textwidth inside it is \trantorColumnSep
% narrower, so columns asking for a share of it leave exactly that much for one
% separator. The separator shrinks but does not stretch, so three or more
% columns summing to the full width share the one separator's worth between them
% rather than overflowing.
%
% The default, column-sep = 0pt, is the class's own layout.
%
% Both environments are the class's own, rebuilt with those two changes. A hook
% cannot do it: env/columns/begin fires early enough that the total-width key
% captures the already-narrowed \textwidth, so the row shrinks with the columns
% and no gutter appears.
\newdimen\trantorColumnSep
\trantorColumnSep=0pt

\ExplSyntaxOn
\RenewDocumentEnvironment { columns } { D <> { all } O { } }
  {
    \__talk_action_begin:n {#1}
    \par
    \int_set_eq:NN \l__talk_column_int \g__talk_column_int
    \int_gzero:N \g__talk_column_int
    \keys_set:nn { talk / columns } {#2}
    \hbox_set_to_wd:Nnw \l__talk_tmp_box { \l__talk_columns_wd_tl }
      \dim_set:Nn \textwidth
        { \l__talk_columns_wd_tl - \trantorColumnSep }
      \dim_set_eq:NN \columnwidth \textwidth
      \ignorespaces
  }
  {
      \unskip
    \hbox_set_end:
    \box_use_drop:N \l__talk_tmp_box
    \int_gset_eq:NN \g__talk_column_int \l__talk_column_int
    \par
    \__talk_action_end:
  }

\RenewDocumentEnvironment { column } { D <> { all } O { } m }
  {
    \par
    \int_gincr:N \g__talk_column_int
    \int_compare:nNnF \g__talk_column_int = 1
      {
        \hfil
        \hskip \trantorColumnSep plus 0pt minus \trantorColumnSep \relax
      }
    \keys_set:nn { talk / column } {#2}
    \vbox_set_to_wd:Nnw \l__talk_tmp_box {#3}
      \dim_set:Nn \textwidth {#3}
      \dim_set_eq:NN \columnwidth \textwidth
      \@parboxrestore
      \leavevmode
      \raggedright
      \__talk_action_begin:n {#1}
      \ignorespaces
  }
  {
      \par
      \__talk_action_end:
    \vbox_set_end:
    \use:c { __talk_column_align_ \l__talk_column_alignment_tl :n }
      { \vbox_unpack_drop:N \l__talk_tmp_box }
    \par
    \@ignoretrue
  }
\ExplSyntaxOff

% -- Bottom progress bar + frame counter (hidden on plain pages).
\newif\iftrantorPlainPage
\trantorPlainPagefalse

% -- Appendix. By default the backup slides after \appendix go on counting up
% while the denominator stays at the number of content slides, so three extras
% on a 15-slide talk read 16/15, 17/15, 18/15 with the bar pinned full. Under
% "appendix = restart" they are numbered among themselves instead, 1/3, 2/3,
% 3/3, and the bar tracks progress through the appendix. The content count
% reaches here through the .aux, so it settles on the second pass like any
% cross-reference.
\newcommand{\trantor@setcontentframes}[1]{\gdef\trantor@contentframes{#1}}

% \immediate, so the value written is the counter here and not at the next
% shipout, which would already include the first backup slide.
\NewDocumentCommand\appendix{}{%
  \global\trantor@inappendixtrue
  \immediate\write\@auxout{\string\trantor@setcontentframes{\trantorFrameNumber}}%
}

% Numerator and denominator of the frame counter. Count registers rather than
% macros: pgfmath expands while parsing, so a macro carrying a conditional loops.
\newcount\trantor@n
\newcount\trantor@d

\newcommand\trantor@setcounts{%
  \ifdefined\trantor@contentframes
    \ifnum\iftrantor@restart\iftrantor@inappendix1\else0\fi\else0\fi=1
      % Restart: both ends measured from the end of the talk proper.
      \trantor@n=\numexpr\trantorFrameNumber-\trantor@contentframes\relax
      \trantor@d=\numexpr\trantorFrameTotal-\trantor@contentframes\relax
    \else
      % Overrun, and every slide before \appendix in either mode.
      \trantor@n=\numexpr\trantorFrameNumber\relax
      \trantor@d=\numexpr\trantor@contentframes\relax
    \fi
  \else
    \trantor@n=\numexpr\trantorFrameNumber\relax
    \trantor@d=\numexpr\trantorFrameTotal\relax
  \fi
}

% How far through the talk we are, as \trantorratio, leaving \trantor@n and
% \trantor@d set for the counter to print. Shared by the footer bar and
% \trantorProgressBar.
\newcommand\trantor@setratio{%
  \trantor@setcounts
  % The guard has to be a \ifnum rather than pgfmath's ?:, which evaluates both
  % branches and so still divides by a zero denominator. That happens on the
  % first pass, before the total is known, and in a deck whose \appendix comes
  % before any content slide.
  \ifnum\trantor@d>0
    % min(..., 1) so an overrunning appendix slide pins the bar full instead of
    % drawing past the page edge.
    \pgfmathsetmacro{\trantorratio}{min(\the\trantor@n / \the\trantor@d, 1)}%
  \else
    \def\trantorratio{0}%
  \fi
}

% \trantorProgressBar{<width>}: a rule of the given width, accent-coloured up to
% the current position and pale the rest of the way. Used by the title divider.
\newlength\trantor@barwidth
\newlength\trantor@barfill

\NewDocumentCommand \trantorProgressBar { m } {%
  \setlength\trantor@barwidth{#1}%
  \trantor@setratio
  % dimen = <factor><dimen>, so \trantorratio scales the width
  \setlength\trantor@barfill{\trantorratio\trantor@barwidth}%
  \textcolor{TrantorAccent}{\rule{\trantor@barfill}{0.6pt}}%
  \textcolor{TrantorDark!20}{%
    \rule{\dimexpr\trantor@barwidth-\trantor@barfill\relax}{0.6pt}}%
}

\AddToHook{shipout/foreground}{%
  \iftrantorPlainPage\else
  \trantorArtifactBegin
  \trantor@setratio
  \begin{tikzpicture}[remember picture, overlay]
    \fill[TrantorAccent]
      (current page.south west)
      rectangle
      ([xshift=\trantorratio\paperwidth, yshift=1pt] current page.south west);
    \iftrantor@shownumber
      \node[anchor=south east, inner sep=5pt, font=\tiny, text=TrantorDark]
        at (current page.south east) {\the\trantor@n\,/\,\the\trantor@d};
    \fi
  \end{tikzpicture}%
  \trantorArtifactEnd
  \fi
  \global\trantorPlainPagefalse
}

% -- Remember the current section title, and dim the others in the mini-TOC.
\ExplSyntaxOn
\tl_new:N \g__trantor_section_tl

\AddToHook{section/begin}{
  \cs_if_exist:NT \l__talk_section_tl {
    \tl_gset:NV \g__trantor_section_tl \l__talk_section_tl
  }
}

\cs_new_protected:Npn \__trantor_print_section: { \tl_use:N \g__trantor_section_tl }
\cs_set_eq:NN \trantorSectionTitle \__trantor_print_section:

% Likewise the subsection, for \subsectionpage. Cleared when a new section
% starts, so a stale title cannot leak into the next one.
\tl_new:N \g__trantor_subsection_tl

\AddToHook{section/begin}{ \tl_gclear:N \g__trantor_subsection_tl }

\AddToHook{subsection/begin}{
  \cs_if_exist:NT \l__talk_subsection_tl {
    \tl_gset:NV \g__trantor_subsection_tl \l__talk_subsection_tl
  }
}

\cs_new_protected:Npn \__trantor_print_subsection: { \tl_use:N \g__trantor_subsection_tl }
\cs_set_eq:NN \trantorSubsectionTitle \__trantor_print_subsection:

% Suspend tagging around the theme's decorative / pagination graphics when
% tagging is on (a no-op otherwise), so the progress bar and frame counter stay
% out of the structure tree instead of being flagged as loose content.
\cs_new_protected:Npn \trantorArtifactBegin
  { \cs_if_exist:NT \tag_suspend:n { \tag_suspend:n { trantor } } }
\cs_new_protected:Npn \trantorArtifactEnd
  { \cs_if_exist:NT \tag_resume:n { \tag_resume:n { trantor } } }

% -- Options. Every key below can be given either as a package option,
%   \usepackage[accent-html = BF1238, divider = title]{trantor}
% or through \trantorset, which works in the preamble or mid-document: the keys
% only set state, which is read when a slide is typeset.
%
%   accent-html = BF1238         accent colour from a hex string
%   accent      = blue!60!black  accent colour from any xcolor expression
%   alert       = TrantorAccent  colour of \alert, from any xcolor expression;
%                                the class's red unless set
%   numbering   = content        (default) title and divider slides consume no
%                                number, so it reads "content slide k of n"
%   numbering   = all            count every slide, so the number tracks the
%                                PDF page
%   numbering   = none           no frame number; the progress bar stays
%   divider     = toc            (default) \sectionpage is the dark panel with
%                                the mini-TOC, current section picked out
%   divider     = title          \sectionpage names only the current section,
%                                over a progress bar on the light background
%   header      = light          (default) frame titles on the page background
%   header      = dark           frame titles in a dark band
%   untitled    = band           (default) frames with no \frametitle still
%                                carry the (empty) header band
%   untitled    = bare           frames with no \frametitle get no band
%   quotes      = upright        (default) quote and quotation in the body face
%   quotes      = italic         quote and quotation in italic, as under beamer
%   fonts       = theme          (default) Libertinus Serif and Sans, Euler maths
%   fonts       = document       the theme sets no faces; the document loads its
%                                own with fontspec and its own maths font
%   logo        = fixed          (default) \titlelogo at a fixed 1.4cm height
%   logo        = fill           \titlelogo fills its column, height capped at
%                                0.32\paperheight, aspect ratio kept
%   links       = all            (default) links are kept on every slide
%   links       = final          a link is kept only on the last slide of its
%                                frame, where under tag-slides=n it is not an
%                                artifact; the text stays on the others
%   column-sep  = 24pt           gutter between columns; 0pt (the default) is
%                                the class's layout, where the gutter is
%                                whatever width the columns leave unclaimed
%   appendix    = overrun        (default) backup slides keep counting past the
%                                total, 16/15, 17/15, with the bar pinned full
%   appendix    = restart        backup slides are numbered among themselves,
%                                1/3, 2/3, and the bar tracks the appendix
%
% Two accent keys rather than one that guesses: a bare hex string cannot be told
% apart from a colour name, since words like "decade" are also valid hex.
%
% divider and header are read when a slide is typeset and at \begin{document}
% respectively, so set header in the preamble; divider may be switched mid-talk.
% fonts is read as the package loads, so it works only as a package option.
\bool_new:N \g__trantor_uncount_bool

\keys_define:nn { trantor }
  {
    accent      .code:n = \colorlet{TrantorAccent}{#1} ,
    accent-html .code:n = \definecolor{TrantorAccent}{HTML}{#1} ,
    alert       .code:n = \colorlet{alert}{#1} ,
    numbering .choice: ,
    numbering / content .code:n =
      { \bool_gset_true:N  \g__trantor_uncount_bool \global\trantor@shownumbertrue } ,
    numbering / all     .code:n =
      { \bool_gset_false:N \g__trantor_uncount_bool \global\trantor@shownumbertrue } ,
    numbering / none    .code:n =
      { \bool_gset_true:N  \g__trantor_uncount_bool \global\trantor@shownumberfalse } ,
    divider .choice: ,
    divider / toc   .code:n = \global\trantor@titledividerfalse ,
    divider / title .code:n = \global\trantor@titledividertrue ,
    header .choice: ,
    header / light .code:n = \global\trantor@darkheaderfalse ,
    header / dark  .code:n = \global\trantor@darkheadertrue ,
    untitled .choice: ,
    untitled / band .code:n = \global\trantor@bareuntitledfalse ,
    untitled / bare .code:n = \global\trantor@bareuntitledtrue ,
    quotes .choice: ,
    quotes / upright .code:n = \global\trantor@italicquotesfalse ,
    quotes / italic  .code:n = \global\trantor@italicquotestrue ,
    fonts .choice: ,
    fonts / theme    .code:n = \global\trantor@documentfontsfalse ,
    fonts / document .code:n = \global\trantor@documentfontstrue ,
    column-sep  .code:n = { \dim_set:Nn \trantorColumnSep {#1} } ,
    logo .choice: ,
    logo / fixed .code:n = \global\trantor@filllogofalse ,
    logo / fill  .code:n = \global\trantor@filllogotrue ,
    links .choice: ,
    links / all   .code:n = \global\trantor@finallinksfalse ,
    links / final .code:n = \global\trantor@finallinkstrue ,
    appendix .choice: ,
    appendix / overrun .code:n = \global\trantor@restartfalse ,
    appendix / restart .code:n = \global\trantor@restarttrue ,
  }
\keys_set:nn { trantor }
  {
    numbering = content,
    divider = toc,
    header = light,
    untitled = band,
    quotes = upright,
    fonts = theme,
    links = all,
    logo = fixed,
    appendix = overrun,
  }

\NewDocumentCommand \trantorset { m } { \keys_set:nn { trantor } {#1} }

% The theme keeps its own frame number rather than adjusting ltx-talk's. The
% class counter also names each frame's hyperref anchor, so decrementing it made
% several frames claim the same destination ("Label 'frame.1' multiply
% defined"). This counts once per frame, not once per page, so overlays of one
% frame keep sharing a number.
\int_new:N \g__trantor_frame_int

\cs_new_protected:Npn \trantorFrameBegin
  {
    \legacy_if:nTF { trantorPlainPage }
      { \bool_if:NF \g__trantor_uncount_bool { \int_gincr:N \g__trantor_frame_int } }
      { \int_gincr:N \g__trantor_frame_int }
  }
\AddToHook { env / frame / begin } { \trantorFrameBegin }

\cs_new:Npn \trantorFrameNumber { \int_use:N \g__trantor_frame_int }

% The total, recorded on the last page the way ltx-talk records its own.
\property_new:nnnn { trantorframes } { shipout } { -1 }
  { \int_use:N \g__trantor_frame_int }
\AddToHook { enddocument / afterlastpage }
  { \property_record:nn { trantorlast } { trantorframes } }
\cs_new:Npn \trantorFrameTotal { \property_ref:nn { trantorlast } { trantorframes } }

% \plainpage: suppress the footer bar and frame number on a frame, as the title
% page and the dark panels do; for a full-bleed image slide, say. Before
% \begin{frame} it marks the coming frame, the way the theme's own plain pages
% do, and \trantorFrameBegin sees the flag. Inside a frame the count has already
% been taken, so the number is given back when the frame would not have counted.
\NewDocumentCommand \plainpage { }
  {
    \global\trantorPlainPagetrue
    \thispagestyle{plain}
    \bool_lazy_and:nnT { \l__talk_frame_bool } { \g__trantor_uncount_bool }
      { \int_gdecr:N \g__trantor_frame_int }
  }

% Run #1 inside the current frame if there is one, else in a fresh frame. Mirrors
% the class's \maketitle, so a document can wrap the title page, a divider or a
% panel in its own frame and put a \note or a \footline alongside -- the beamer
% idiom. Called between frames, they open their own as before.
\cs_new_protected:Npn \trantor@inframe #1
  {
    \bool_if:NTF \l__talk_frame_bool
      {#1}
      { \begin{frame} #1 \end{frame} }
  }
% The same, with the frame's optional argument.
\cs_new_protected:Npn \trantor@inframe@opt #1 #2
  {
    \bool_if:NTF \l__talk_frame_bool
      {#2}
      { \begin{frame}[#1] #2 \end{frame} }
  }

% Set while typesetting an \outlinepage, where no entry is the "current" one and
% everything is printed at full opacity.
\bool_new:N \g__trantor_outline_bool
\cs_new_protected:Npn \trantorOutlineBegin { \bool_gset_true:N  \g__trantor_outline_bool }
\cs_new_protected:Npn \trantorOutlineEnd   { \bool_gset_false:N \g__trantor_outline_bool }

% Soften the dimming of inactive TOC entries on the section page (0.2 -> 0.7).
% ltx-talk exposes no key for this yet, so we override the class-private
% \__talk_toc_dest:w. Revisit if a supported interface appears or the internal
% changes.
\cs_set_protected:Npn \__talk_toc_dest:w #1 . #2 . #3 . #4 . #5 \q_stop #6
  {
    \bool_lazy_or:nnTF
      { \g__trantor_outline_bool }
      {
        \bool_lazy_or_p:nn
          {
            \bool_lazy_and_p:nn
              { \int_compare_p:nNn { \value { section } } = {#2} }
              { \int_compare_p:nNn { \value { subsection } } = 0 }
          }
          {
            \bool_lazy_and_p:nn
              { \int_compare_p:nNn { \value { section } } = {#2} }
              { \int_compare_p:nNn { \value { subsection } } = {#3} }
          }
      }
      {#6}
      { \opacity_begin:n { 0.7 } #6 \opacity_end: }
  }
\ExplSyntaxOff

% The same keys are accepted as package options, so a deck can be configured
% declaratively:  \usepackage[accent-html = BF1238, divider = title]{trantor}
% Processed after the defaults set above, so an option overrides them, and
% \trantorset still works afterwards for anything you want to change mid-talk.
\ProcessKeyOptions[trantor]

% -- Fonts. Sans as the body family at a slightly open leading either way; the
% faces themselves only under "fonts = theme".
\renewcommand{\familydefault}{\sfdefault}
\linespread{1.18}
\iftrantor@documentfonts
  % The document sets its own faces and maths font; the titles take its sans.
  \providecommand\headerfont{\sffamily}
\else
  % Text: Libertinus Serif (body) and Libertinus Sans (titles).
  \setsansfont{Libertinus Serif}[Scale=1.05]
  \newfontfamily\headerfont{Libertinus Sans}[Ligatures=TeX]
  % Maths: Euler (lum-euler, a lua-unicode-math package; needs v0.9+). Change
  % this line for a different maths font, e.g. lum-libertinus.
  \RequirePackage{lum-euler}
\fi

% -- Title page. Drop a logo.png next to your slides, or redefine \titlelogo.
% Under "logo = fill" the logo takes the width of the column it sits in rather
% than a fixed height, capped so a tall one cannot overrun the title block. A
% wide, short logo -- a wordmark, say -- is tiny at a fixed height, because the
% height is doing all the work and the width follows the aspect ratio.
\newcommand{\titlelogo}{%
  \IfFileExists{logo.png}
    {\iftrantor@filllogo
       \includegraphics[width=\linewidth, height=0.32\paperheight,
         keepaspectratio, alt={Organisation logo}]{logo.png}%
     \else
       \includegraphics[height=1.4cm, alt={Organisation logo}]{logo.png}%
     \fi}{}%
}

% Bottom-aligned: ltx-talk centres frame content by default, which leaves a
% plain \vfill here with nothing to stretch against. The \vspace at the end is
% then the margin below the block rather than a nudge off centre.
\renewcommand{\maketitle}{%
  \trantor@inframe@opt{vertical-alignment = bottom}{%
    \plainpage
    \hspace*{0.04\paperwidth}%
    \begin{minipage}{0.82\paperwidth}
      \raggedright
      {\color{TrantorDark}\headerfont\Large\bfseries \@title\par}%
      % \@subtitle is only defined if the class provides \subtitle, and only
      % non-empty if the document set one.
      \ifdefined\@subtitle
        \ifx\@subtitle\empty\else
          \vspace{0.35em}%
          % Serif (the body family), not \headerfont: Libertinus Sans is used
          % bold throughout, so a light sans subtitle would be the odd one out.
          {\color{TrantorDark}\large \@subtitle\par}%
        \fi
      \fi
      \vspace{0.5em}%
      {\color{TrantorAccent}\rule{\linewidth}{0.8pt}\par}%
      \vspace{1.3em}%
      % Metadata on the left, logo on the right; bottom-aligned so the logo sits
      % level with the date and grows upward rather than below it.
      \begin{minipage}[b]{0.66\linewidth}
        \raggedright
        {\normalsize \@author\par}%
        \ifx\@institute\empty\else
          \vspace{0.2em}%
          {\small\color{TrantorMuted} \@institute\par}%
        \fi
        \vspace{0.2em}%
        {\small \@date\par}%
      \end{minipage}%
      \hfill
      \begin{minipage}[b]{0.30\linewidth}
        \raggedleft
        \titlelogo
      \end{minipage}%
    \end{minipage}%
    \hspace*{0.04\paperwidth}%
    \vspace{0.12\paperheight minus 0.08\paperheight}%
  }%
}

% -- The dark, full-bleed panel behind \sectionpage, \outlinepage and \standout:
% a plain frame flooded with TrantorDark, with #1 centred on it.
\NewDocumentCommand \trantorDarkFrame { +m } {%
  \trantor@inframe{%
    \plainpage
    \noindent
    \begin{tikzpicture}[overlay=false, remember picture=false]
      \useasboundingbox (0,0) rectangle (\linewidth,-\textheight);
      \fill[TrantorDark]
        (-\Gm@lmargin, \paperheight)
        rectangle
        (\dimexpr\paperwidth-\Gm@lmargin\relax, -\paperheight);
      \node[text=TrantorLight, anchor=center, inner sep=0pt]
        at (0.5\linewidth, -0.5\textheight) {#1};
    \end{tikzpicture}%
  }%
}

% The mini-TOC as it appears on those panels.
\newcommand{\trantorTOC}{%
  \begin{minipage}{\linewidth}
    \centering
    \setcounter{tocdepth}{1}%
    \colorlet{structure}{TrantorLight}%
    \setlength{\parskip}{1.2em}%   spacing between TOC entries
    \headerfont\Large
    \tableofcontents
  \end{minipage}%
}

% -- The divider used by "divider = title": the section name over a progress
% bar, on the ordinary light background. Deliberately not a plain page -- it
% carries a number and the footer bar, so it reads as part of the talk.
\NewDocumentCommand \trantor@divider { +m } {%
  \trantor@inframe{%
    \thispagestyle{plain}%
    \centering
    \begin{minipage}{0.52\linewidth}%
      \raggedright
      {\headerfont\Large\bfseries\color{TrantorDark}\trantorSectionTitle\par}%
      \vspace{0.4em}%
      \trantorProgressBar{\linewidth}%
      #1%
    \end{minipage}%
    \par
  }%
}

% -- Section divider page. By default the mini-TOC with the current section
% picked out (the rest dimmed by the \__talk_toc_dest:w override above);
% under "divider = title", the section name alone over a progress bar.
\NewDocumentCommand \sectionpage { } {%
  \iftrantor@titledivider
    \trantor@divider{}%
  \else
    \trantorDarkFrame{\trantorTOC}%
  \fi
}

% -- Subsection divider page: the section title above the subsection it
% introduces, following whichever divider style is set.
\NewDocumentCommand \subsectionpage { } {%
  \iftrantor@titledivider
    \trantor@divider{%
      \par\vspace{0.8em}%
      {\headerfont\large\bfseries\color{TrantorDark}\trantorSubsectionTitle\par}%
    }%
  \else
    \trantorDarkFrame{%
      \begin{minipage}{0.8\linewidth}
        \centering
        \headerfont\bfseries
        {\large\trantorSectionTitle\par}
        \vspace{0.7em}
        {\LARGE\trantorSubsectionTitle\par}
      \end{minipage}%
    }%
  \fi
}

% -- Outline page: the same panel and TOC, but with no current section to pick
% out, so every entry is printed in full white. Meant for the overview slide
% after the title page, or between parts of a long talk.
\NewDocumentCommand \outlinepage { } {%
  \trantorOutlineBegin
  \trantorDarkFrame{\trantorTOC}%
  \trantorOutlineEnd
}

% \standout{...}: a full frame with the same dark panel, and the given text
% centred on it.
\NewDocumentCommand \standout { +m } {%
  \trantorDarkFrame{%
    \begin{minipage}{0.8\linewidth}
      \centering
      \headerfont\LARGE\bfseries
      #1
    \end{minipage}%
  }%
}

\makeatother
